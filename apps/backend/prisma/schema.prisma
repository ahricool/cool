generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String?  @map("password_hash")
  displayName  String   @map("display_name") @db.VarChar(100)
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  authVersion  Int      @default(0) @map("auth_version")
  posts        Post[]
  sessions     AdminSession[]

  @@map("users")
}

// Logout/revoke/password change invalidates the server-side session before the
// JWT and browser cookie reach their matching 15-day expiration.
model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String    @map("csrf_token")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("admin_sessions")
}

model Post {
  id            String         @id @default(uuid()) @db.Uuid
  slug          String         @unique @db.VarChar(160)
  title         String         @db.VarChar(200)
  excerpt       String         @default("") @db.VarChar(500)
  content       String         @default("")
  contentFormat String         @default("markdown") @map("content_format")
  coverUrl      String?        @map("cover_url")
  status        PostStatus     @default(DRAFT)
  publishedAt   DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  authorId      String         @map("author_id") @db.Uuid
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  viewCount     Int            @default(0) @map("view_count")
  commentCount  Int            @default(0) @map("comment_count")
  comments      Comment[]
  categories    PostCategory[]
  tags          PostTag[]

  @@index([status, publishedAt, id])
  @@map("posts")
}

model Category {
  id    String         @id @default(uuid()) @db.Uuid
  name  String         @db.VarChar(100)
  slug  String         @unique @db.VarChar(160)
  posts PostCategory[]

  @@map("categories")
}

model Tag {
  id    String    @id @default(uuid()) @db.Uuid
  name  String    @db.VarChar(100)
  slug  String    @unique @db.VarChar(160)
  posts PostTag[]

  @@map("tags")
}

model PostCategory {
  postId     String   @map("post_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
  @@map("post_categories")
}

model PostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model SiteSetting {
  key       String   @id @db.VarChar(100)
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

model Page {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique @db.VarChar(160)
  title       String     @db.VarChar(200)
  content     String     @default("")
  coverUrl    String?    @map("cover_url")
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, publishedAt])
  @@map("pages")
}

model Moment {
  id          String     @id @default(uuid()) @db.Uuid
  content     String
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, publishedAt])
  @@map("moments")
}

model Photo {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  description String   @default("") @db.VarChar(500)
  url         String
  album       String   @default("") @db.VarChar(100)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([published, createdAt])
  @@map("photos")
}

model Link {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  url         String
  logoUrl     String?  @map("logo_url")
  description String   @default("") @db.VarChar(500)
  group       String   @default("朋友们") @db.VarChar(100)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([published, createdAt])
  @@map("links")
}

model Media {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type")
  size         Int
  width        Int
  height       Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("media")
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  name      String        @db.VarChar(80)
  content   String        @db.VarChar(3000)
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([postId, status, createdAt])
  @@map("comments")
}
