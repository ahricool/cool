generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ContentLocale {
  zh
  en
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(254)
  passwordHash String?        @map("password_hash")
  displayName  String         @map("display_name") @db.VarChar(100)
  avatarUrl    String?        @map("avatar_url")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  authVersion  Int            @default(0) @map("auth_version")
  posts        Post[]
  sessions     AdminSession[]

  @@map("users")
}

// Logout/revoke/password change invalidates the server-side session before the
// JWT and browser cookie reach their matching 15-day expiration.
model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String    @map("csrf_token")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("admin_sessions")
}

model Post {
  translations PostTranslation[]
  id           String            @id @default(uuid()) @db.Uuid
  slug         String            @unique @db.VarChar(160)
  coverUrl     String?           @map("cover_url")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  authorId     String            @map("author_id") @db.Uuid
  author       User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  viewCount    Int               @default(0) @map("view_count")
  commentCount Int               @default(0) @map("comment_count")
  comments     Comment[]
  categories   PostCategory[]
  tags         PostTag[]

  @@map("posts")
}

model Category {
  translations CategoryTranslation[]
  id           String                @id @default(uuid()) @db.Uuid
  slug         String                @unique @db.VarChar(160)
  posts        PostCategory[]

  @@map("categories")
}

model Tag {
  translations TagTranslation[]
  id           String           @id @default(uuid()) @db.Uuid
  slug         String           @unique @db.VarChar(160)
  posts        PostTag[]

  @@map("tags")
}

model PostCategory {
  postId     String   @map("post_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
  @@map("post_categories")
}

model PostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model SiteSetting {
  key       String   @id @db.VarChar(100)
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

model Page {
  translations PageTranslation[]
  id           String            @id @default(uuid()) @db.Uuid
  slug         String            @unique @db.VarChar(160)
  coverUrl     String?           @map("cover_url")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pages")
}

model Moment {
  translations MomentTranslation[]
  id           String              @id @default(uuid()) @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("moments")
}

model Photo {
  translations PhotoTranslation[]
  id           String             @id @default(uuid()) @db.Uuid
  url          String
  published    Boolean            @default(false)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([published, createdAt])
  @@map("photos")
}

model Link {
  translations LinkTranslation[]
  id           String            @id @default(uuid()) @db.Uuid
  url          String
  logoUrl      String?           @map("logo_url")
  published    Boolean           @default(false)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([published, createdAt])
  @@map("links")
}

model Media {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type")
  size         Int
  width        Int
  height       Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("media")
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  name      String        @db.VarChar(80)
  content   String        @db.VarChar(3000)
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([postId, status, createdAt])
  @@map("comments")
}

model PostTranslation {
  postId        String        @map("post_id") @db.Uuid
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale        ContentLocale
  title         String        @db.VarChar(200)
  excerpt       String        @default("") @db.VarChar(500)
  content       String        @default("")
  contentFormat String        @default("markdown") @map("content_format")
  status        PostStatus    @default(DRAFT)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([postId, locale])
  @@index([locale, status, publishedAt])
  @@map("post_translations")
}

model PageTranslation {
  pageId      String        @map("page_id") @db.Uuid
  page        Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale      ContentLocale
  title       String        @db.VarChar(200)
  content     String        @default("")
  status      PostStatus    @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([pageId, locale])
  @@index([locale, status, publishedAt])
  @@map("page_translations")
}

model MomentTranslation {
  momentId    String        @map("moment_id") @db.Uuid
  moment      Moment        @relation(fields: [momentId], references: [id], onDelete: Cascade)
  locale      ContentLocale
  content     String
  status      PostStatus    @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([momentId, locale])
  @@index([locale, status, publishedAt])
  @@map("moment_translations")
}

model CategoryTranslation {
  categoryId String        @map("category_id") @db.Uuid
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     ContentLocale
  name       String        @db.VarChar(100)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model TagTranslation {
  tagId  String        @map("tag_id") @db.Uuid
  tag    Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  locale ContentLocale
  name   String        @db.VarChar(100)

  @@id([tagId, locale])
  @@map("tag_translations")
}

model PhotoTranslation {
  photoId     String        @map("photo_id") @db.Uuid
  photo       Photo         @relation(fields: [photoId], references: [id], onDelete: Cascade)
  locale      ContentLocale
  title       String        @db.VarChar(200)
  description String        @default("") @db.VarChar(500)
  album       String        @default("") @db.VarChar(100)

  @@id([photoId, locale])
  @@map("photo_translations")
}

model LinkTranslation {
  linkId      String        @map("link_id") @db.Uuid
  link        Link          @relation(fields: [linkId], references: [id], onDelete: Cascade)
  locale      ContentLocale
  name        String        @db.VarChar(100)
  description String        @default("") @db.VarChar(500)
  group       String        @default("") @db.VarChar(100)

  @@id([linkId, locale])
  @@map("link_translations")
}
