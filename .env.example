NODE_ENV=development
PORT=3000
# Direct development ignores forwarding headers; production Compose sets this to 1.
TRUST_PROXY_HOPS=0
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://cms:local-development-only@localhost:5433/cms
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3001
HTTP_PORT=8080
# Relative to apps/backend for npm run dev; use an absolute path for direct node start.
MEDIA_ROOT=../../data/uploads
