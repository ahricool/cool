NODE_ENV=development
PORT=3000
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://cms:local-development-only@localhost:5433/cms
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Administrator
HTTP_PORT=8080
CMS_IMAGE=sakura-cms-backend:local
CMS_FRONTEND_IMAGE=sakura-cms-frontend:local
CMS_ADMIN_IMAGE=sakura-cms-admin:local
# Relative to apps/backend for npm run dev; use an absolute path for direct node start.
MEDIA_ROOT=../../data/uploads
