NODE_ENV=development
PORT=3000
POSTGRES_DB=cool
POSTGRES_USER=cool
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://cool:local-development-only@localhost:5433/cool
JWT_SECRET=replace-with-at-least-32-random-characters
HTTP_PORT=8080
# Optional: absolute path or relative to the project root, regardless of cwd.
# Production Compose bind-mounts this host directory at /app/data.
MEDIA_ROOT=./data
